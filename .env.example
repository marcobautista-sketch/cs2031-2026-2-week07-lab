# Copy this file to .env and adjust it if any of these ports is already in use.
# It is read by docker compose and by the Spring Boot app.

# Port the API listens on
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flyaway
DB_USER=flyaway
DB_PASSWORD=flyaway

# JWT signing key (must be at least 32 characters for HS256)
JWT_SECRET=dev-only-secret-change-me-in-production-please-32-bytes-minimum
JWT_EXPIRATION_MS=3600000

# Folder where the booking confirmation emails are written
EMAIL_OUTPUT_DIR=emails
